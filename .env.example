# Frontend (Vite) environment variables
# Copy this file to .env and fill in your own values.
# Everything prefixed with VITE_ is inlined into the client bundle at build
# time and is therefore PUBLIC — never put a secret or private key here.

# Privy application ID — https://dashboard.privy.io
VITE_PRIVY_APP_ID=your_privy_app_id

# Base URL of the backend API (see server/.env.example for the server side)
VITE_API_URL=http://localhost:3001

# Infura project ID used for read-only RPC calls
VITE_INFURA_API_KEY=your_infura_api_key

# Supabase project URL and anon (public) key — https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
